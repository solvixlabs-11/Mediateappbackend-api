# Mediate Healthcare Backend Environment Variables

ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["*"]

# Database Connection (SQL Server)
# For local Windows SQLEXPRESS or Docker SQL Server container:
DATABASE_URL=mssql+pyodbc://sa:YourStrongPassword123!@localhost:1433/mediate_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT Auth & Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# File Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# Geofence Defaults (meters)
DEFAULT_GEOFENCE_DOCTOR_RADIUS_METERS=200.0
DEFAULT_GEOFENCE_CHEMIST_RADIUS_METERS=150.0
MAX_LOCATION_ACCURACY_THRESHOLD_METERS=100.0
