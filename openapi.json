{
  "openapi": "3.1.0",
  "info": {
    "title": "Mediate Healthcare MR App",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service Health Check",
        "description": "Returns basic liveness status and version of the API.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service Readiness Check",
        "description": "Returns detailed readiness checks for external services like SQL Server.",
        "operationId": "get_ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service Health Check",
        "description": "Returns basic liveness status and version of the API.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service Readiness Check",
        "description": "Returns detailed readiness checks for external services like SQL Server.",
        "operationId": "get_ready_api_v1_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "examples": [
              "0.1.0"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "examples": [
              "development"
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "timestamp",
          "environment"
        ],
        "title": "HealthResponse",
        "description": "Schema for basic service health check."
      },
      "ReadinessComponent": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ReadinessComponent",
        "description": "Component readiness status."
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ready"
            ]
          },
          "uptime_seconds": {
            "type": "number",
            "title": "Uptime Seconds"
          },
          "components": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReadinessComponent"
            },
            "type": "object",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "status",
          "uptime_seconds",
          "components"
        ],
        "title": "ReadyResponse",
        "description": "Schema for detailed system readiness."
      }
    }
  }
}